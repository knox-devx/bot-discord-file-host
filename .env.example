# Discord
DISCORD_TOKEN=COLOQUE_O_TOKEN_DO_BOT_AQUI
BOT_NAME=Knox File Host
SYNC_COMMANDS=true

# API File Host / Base44
API_BASE_URL=https://file-host.base44.app

# Documentação atual:
# https://file-host.base44.app/docs
#
# Se a documentação informar a URL completa do endpoint de upload,
# coloque-a aqui. Quando preenchida, ela tem prioridade sobre API_FUNCTIONS.
API_UPLOAD_URL=

# Nomes de funções tentados quando API_UPLOAD_URL estiver vazio.
API_FUNCTIONS=upload,upload-file,host-file

# Autenticação opcional da API.
API_KEY=
API_KEY_HEADER=Authorization
API_KEY_PREFIX=Bearer

# Timeouts. Valores altos ajudam com arquivos grandes.
API_CONNECT_TIMEOUT=30
API_READ_TIMEOUT=1800
